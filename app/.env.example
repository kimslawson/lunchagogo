# ---------------------------------------------------------------------------
# Lunch a Go-Go — environment
# Copy to `.env` and fill in. Never commit real keys (.env is git-ignored).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
# The anon key is safe to ship to the browser; Row-Level Security protects data.
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Web Push — generate a keypair once with:  npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# ---- Secrets for the push Edge Function ONLY (set via `supabase secrets set`) ----
# These are NOT used by the static app and never reach the browser. They live in
# Supabase (supabase/functions/notify), not in your static host.
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:getlunchagogo@gmail.com"

# The service role key bypasses RLS — it belongs only in the Edge Function's
# secrets, never in this app.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
